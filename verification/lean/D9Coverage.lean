import Mathlib.Algebra.Order.Field.Basic
import Mathlib.Algebra.Order.Ring.Int
import Mathlib.Order.Interval.Set.Basic
import Mathlib.Basic.Real.Basic
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Linarith

/-! Exact coverage check for the two finite D9 sign regions.
Arb certifies the pointwise lower enclosures. Lean checks every endpoint,
adjacency and the positivity of every stored dyadic margin. -/
namespace GenesisD9Coverage

structure Cell where
  left : ℕ
  right : ℕ
  mantissa : ℕ
  exponent : ℤ

def valid (left finish : ℕ) : List Cell → Bool
  | [] => left == finish
  | c :: cs =>
    decide (c.left = left ∧ c.left < c.right ∧ 0 < c.mantissa) &&
      valid c.right finish cs

noncomputable def point (scale : ℝ) (n : ℕ) : ℝ := (n : ℝ) / scale

noncomputable def lower (c : Cell) : ℝ := (c.mantissa : ℝ) * (2 : ℝ) ^ c.exponent

def Sound (scale : ℝ) (f : ℝ → ℝ) (cells : List Cell) : Prop :=
  ∀ c ∈ cells, ∀ x ∈ Set.Icc (point scale c.left) (point scale c.right), lower c ≤ f x

/-- A validated closed partition with sound cell bounds is strictly positive
on its whole interval, including the endpoints. -/
theorem positive_of_valid {scale : ℝ} (hscale : 0 < scale) {f : ℝ → ℝ}
    {left finish : ℕ} {cells : List Cell} (horder : left < finish)
    (hv : valid left finish cells = true) (hs : Sound scale f cells) :
    ∀ x ∈ Set.Icc (point scale left) (point scale finish), 0 < f x := by
  induction cells generalizing left with
  | nil =>
    have h : left = finish := by simpa [valid] using hv
    exact False.elim (horder.ne h)
  | cons c cs ih =>
    have h : (c.left = left ∧ c.left < c.right ∧ 0 < c.mantissa) ∧
        valid c.right finish cs = true := by simpa [valid] using hv
    intro x hx
    by_cases hx' : x ≤ point scale c.right
    · have hc : 0 < (c.mantissa : ℝ) := by exact_mod_cast h.1.2.2
      have hp : 0 < lower c := mul_pos hc (zpow_pos (by norm_num) _)
      exact hp.trans_le (hs c (List.mem_cons_self) x ⟨h.1.1 ▸ hx.1, hx'⟩)
    · have hr : point scale c.right < point scale finish :=
        (lt_of_not_ge hx').trans_le hx.2
      have hn : c.right < finish := by
        by_contra! hle
        have hm : (finish : ℝ) ≤ (c.right : ℝ) := by exact_mod_cast hle
        exact (not_lt_of_ge (div_le_div_of_nonneg_right hm hscale.le)) hr
      exact ih hn h.2 (fun d hd => hs d (List.mem_cons_of_mem _ hd))
        x ⟨(lt_of_not_ge hx').le, hx.2⟩

