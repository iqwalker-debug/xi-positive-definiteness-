theorem check_near256 : valid 0 64 near256 = true := by decide
set_option maxRecDepth 4096 in
theorem check_middle256 : valid 64 320 middle256 = true := by decide

theorem near_positive {f : ℝ → ℝ} (hs : Sound 320 f near256) :
    ∀ x ∈ Set.Icc (0 : ℝ) (1 / 5), 0 < f x := by
  have h := positive_of_valid (by norm_num : (0 : ℝ) < 320)
    (by decide : (0 : ℕ) < 64) check_near256 hs
  convert h using 1; norm_num [point]

theorem middle_positive {f : ℝ → ℝ} (hs : Sound 320 f middle256) :
    ∀ x ∈ Set.Icc (1 / 5 : ℝ) 1, 0 < f x := by
  have h := positive_of_valid (by norm_num : (0 : ℝ) < 320)
    (by decide : (64 : ℕ) < 320) check_middle256 hs
  convert h using 1; norm_num [point]

/-- Combine the two table-driven sign regions with the radial identities and
the separate analytic tail. The soundness of the Arb entries stays explicit. -/
theorem profile_positive_of_cells {U P N : ℝ → ℝ}
    (hp : Sound 320 P near256) (hn : Sound 320 N middle256)
    (hnear : (∀ x ∈ Set.Icc (0 : ℝ) (1 / 5), 0 < P x) →
      ∀ r ∈ Set.Icc (0 : ℝ) (1 / 5), 0 < U r)
    (hmiddle : ∀ r ∈ Set.Icc (1 / 5 : ℝ) 1, N r = r ^ 7 * U r)
    (hfar : ∀ r : ℝ, 1 ≤ r → 0 < U r) :
    ∀ r : ℝ, 0 ≤ r → 0 < U r := by
  intro r hr
  by_cases h₁ : r ≤ 1 / 5
  · exact hnear (near_positive hp) r ⟨hr, h₁⟩
  by_cases h₂ : r ≤ 1
  · have hm : r ∈ Set.Icc (1 / 5 : ℝ) 1 := ⟨(lt_of_not_ge h₁).le, h₂⟩
    have hpos : 0 < r ^ 7 := pow_pos (by linarith [hm.1]) 7
    have hN := middle_positive hn r hm
    rw [hmiddle r hm] at hN
    exact (mul_pos_iff_of_pos_left hpos).mp hN
  · exact hfar r (lt_of_not_ge h₂).le

-- Negative controls: deleting a cell, zeroing a margin, or choosing a
-- wrong right endpoint must not be accepted.
example : valid 0 64 near256.tail = false := by decide
example : valid 0 1 [⟨0, 1, 0, -1⟩] = false := by decide
example : valid 64 319 middle256 = false := by decide

