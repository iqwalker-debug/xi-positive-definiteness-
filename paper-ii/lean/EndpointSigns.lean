-- All arguments q are integers representing q/10^12. Multiplying P_m by
-- 10^45 * m! * (10^12)^m gives this signed linear form on the coefficient boxes.
def weight (m j : Nat) (q : Int) : Int :=
  (-1 : Int)^m * q^(m-j) * (m.descFactorial j : Int) * (10^12 : Int)^j

def bound (lower : Bool) (m : Nat) (q : Int) : Int :=
  ((List.range (m+1)).map fun j =>
    let (l,h) := boxes[j]!
    let w := weight m j q
    if lower then min (w*l) (w*h) else max (w*l) (w*h)).sum

def goodRow (i : Nat) : Bool :=
  let (l,h,printed) := brackets[i]!
  let m := i+1
  -- Width 2e-12, separated from previous bracket, and valid coefficient indices.
  decide (h-l = 2) && (i == 0 || decide (h < (brackets[i-1]!).1)) &&
    decide (m < boxes.length) &&
    decide (0 < bound true m l) && decide (bound false m h < 0) &&
    -- Intersect with the rounding cell for the 11th decimal; prove both strict signs.
    decide (max l (printed-5) < min h (printed+5)) &&
    decide (0 < bound true m (max l (printed-5))) &&
    decide (bound false m (min h (printed+5)) < 0)

theorem allBracketSigns : brackets.length = 13 ∧
    boxes.all (fun p => decide (p.1 ≤ p.2)) = true ∧
    (List.range 13).all goodRow = true := by decide

-- Exact denominator-cleared geometric ratio test on [0,1/4] for j=0,...,14.
theorem allRemainderRatios :
    (List.range 15).all (fun j => decide (10 * 122^j < 12 * 121^j)) = true := by decide

-- Historical regression: these rounded values were exported at commit 84b33ff.
-- The corrected JSON stores exact dyadic endpoints.
-- P'_m = -P_(m-1), so an upper for the latter gives a lower for the former.
def badExports : List (Nat × Int × Int) := [
  (5, -253057, 2500),
  (8, -12381423, 1000),
  (9, -33707773, 500),
  (11, -21662901, 10),
  (13, -74765453, 1)
]

def violated (row : Nat × Int × Int) : Bool :=
  let (m,num,den) := row
  let (l,h,_) := brackets[m-1]!
  let n := m-1
  let scale : Int := (10^45) * (n.factorial : Int) * (10^12)^n
  decide ((l+h)%2 = 0 ∧ 0 < den ∧ num*scale < -(bound false n ((l+h)/2))*den)

theorem fiveFalseUppers : badExports.all violated = true := by decide
/-- Exact integer enclosure of a real linear form for any choice inside the boxes. -/
theorem encloseSum (js : List Nat) (w : Nat → Int) (v : Nat → ℝ)
    (input : ∀ j ∈ js, ((boxes[j]!).1 : ℝ) ≤ v j ∧ v j ≤ ((boxes[j]!).2 : ℝ)) :
    (((js.map fun j => min (w j * boxes[j]!.1) (w j * boxes[j]!.2)).sum : Int) : ℝ)
      ≤ (js.map fun j => (w j : ℝ) * v j).sum ∧
    (js.map fun j => (w j : ℝ) * v j).sum ≤
    (((js.map fun j => max (w j * boxes[j]!.1) (w j * boxes[j]!.2)).sum : Int) : ℝ) := by
  induction js with
  | nil => simp
  | cons j rest ih =>
    obtain ⟨ihL, ihU⟩ := ih (fun k hk => input k (List.mem_cons_of_mem _ hk))
    obtain ⟨lo,hi⟩ := input j (by simp)
    simp only [List.map_cons, List.sum_cons, Int.cast_add, Int.cast_min, Int.cast_max, Int.cast_mul]
    by_cases h : 0 ≤ (w j : ℝ)
    · exact ⟨add_le_add ((min_le_left _ _).trans (mul_le_mul_of_nonneg_left lo h)) ihL,
        add_le_add ((mul_le_mul_of_nonneg_left hi h).trans (le_max_right _ _)) ihU⟩
    · have hn := le_of_not_ge h
      exact ⟨add_le_add ((min_le_right _ _).trans (mul_le_mul_of_nonpos_left hi hn)) ihL,
        add_le_add ((mul_le_mul_of_nonpos_left lo hn).trans (le_max_left _ _)) ihU⟩
#print axioms encloseSum

#print axioms fiveFalseUppers
#print axioms allBracketSigns
#print axioms allRemainderRatios
